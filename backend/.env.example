# Core App
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Native PostgreSQL with pgvector
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@127.0.0.1:5432/clarifibids_db
SYNC_DATABASE_URL=postgresql+psycopg://postgres:your_password_here@127.0.0.1:5432/clarifibids_db

# LLM Provider (Groq Cloud) - Get your API key from https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Embedding Model (SentenceTransformers local CPU/GPU)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Retrieval & Corrective RAG (CRAG) Parameters
TOP_K=4
RELEVANCE_THRESHOLD=0.65
SUFFICIENCY_THRESHOLD=0.70
MAX_RETRIEVAL_ATTEMPTS=2
MAX_CONTEXT_TOKENS=3000
MAX_OUTPUT_TOKENS=512

# Authentication
AUTH_ENABLED=true
